{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Haven",
  "version": "0.1.5",
  "identifier": "com.claudevm.workspace",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "Claude Haven", "width": 1440, "height": 900, "minWidth": 960, "minHeight": 640 }],
    "security": { "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:6080; frame-src http://127.0.0.1:6080" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": { "nsis": { "compression": "lzma", "installerIcon": "icons/icon.ico", "uninstallerIcon": "icons/icon.ico" } },
    "resources": {
      "../runtime/rootfs.tar.gz": "runtime/rootfs.tar.gz",
      "../runtime/scripts/": "runtime/scripts/",
      "../runtime/assets/": "runtime/assets/"
    }
  }
}
