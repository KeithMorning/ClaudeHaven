!! Claude — openbox 主题
!! 目的：扁平深色标题栏，和壁纸 / 面板 / 终端同一套色。
!! 只用纯色（flat solid），不带位图，任何分辨率都干净。

!! ---------------- 窗口 ----------------
window.active.title.bg: flat solid
window.active.title.bg.color: #1b1a19
window.active.label.bg: parentrelative
window.active.label.text.color: #f3efeb
window.active.border.color: #4b4947
window.active.client.color: #121212
window.active.handle.bg: flat solid
window.active.handle.bg.color: #1b1a19
window.active.grip.bg: flat solid
window.active.grip.bg.color: #302520

window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #171615
window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #9b928b
window.inactive.border.color: #363331
window.inactive.client.color: #121212
window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #171615
window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #171615

window.label.active.text.color: #f3efeb
window.label.inactive.text.color: #9b928b
window.label.active.text.justify: left
window.label.inactive.text.justify: left
window.active.title.separator.color: #373330
window.inactive.title.separator.color: #292725

!! 按钮：透明底 + 单色字形（不开方框，避免出现一块块色斑）
window.*.button.*.bg: parentrelative
window.active.button.*.image.color: #d9d0c9
window.active.button.*.hover.image.color: #ffffff
window.inactive.button.*.image.color: #8f8781
window.active.button.*.hover.bg: flat solid
window.active.button.*.hover.bg.color: #30251f
window.inactive.button.*.hover.bg: flat solid
window.inactive.button.*.hover.bg.color: #24211f
window.active.button.*.pressed.bg: flat solid
window.active.button.*.pressed.bg.color: #3b2a21
window.inactive.button.*.pressed.bg: flat solid
window.inactive.button.*.pressed.bg.color: #2b2521

!! ---------------- 尺寸 ----------------
border.width: 1
padding.width: 8
padding.height: 9
window.handle.width: 0
window.client.padding.width: 0
window.client.padding.height: 0

!! ---------------- 菜单 ----------------
menu.border.color: #403b37
menu.items.bg: flat solid
menu.items.bg.color: #1b1a19
menu.items.text.color: #e2d9d1
menu.items.disabled.text.color: #817871
menu.items.active.bg: flat solid
menu.items.active.bg.color: #3a2b24
menu.items.active.text.color: #ffffff
menu.title.bg: flat solid
menu.title.bg.color: #27221f
menu.title.text.color: #b6a79c
menu.separator.color: #403b37

!! ---------------- 屏幕提示 ----------------
osd.bg: flat solid
osd.bg.color: #1b1a19
osd.border.color: #403b37
osd.text.color: #f3efeb
